# Copy this file to .env (gitignored) and fill in from your browser while logged in to leetcode.com.
# DevTools > Application > Cookies > https://leetcode.com
#   LEETCODE_SESSION <- cookie named LEETCODE_SESSION
#   LEETCODE_CSRFTOKEN    <- cookie named csrftoken
# Only needed for `lc submit` and `lc new`. `lc test` works without these.
LEETCODE_SESSION=
LEETCODE_CSRFTOKEN=
